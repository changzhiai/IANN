# LAMMPS input script for IANN machine learning potential
# Example for silicon with PaiNN potential
# Complete silicon simulation example
# Shows proper parameter settings for ML potentials
# Includes equilibration, production, and analysis steps

# example 1: 

units metal
atom_style atomic
boundary p p p

read_data initial.data

# Define the IANN pair style
pair_style iann painn export_ensemble_painn.pth  5.5
pair_coeff * *

mass 1 1.0079999997406976 # H
mass 2 195.08399994981576 # Pt

neighbor 0.5 bin
neigh_modify every 1 delay 0 check yes

# Thermodynamic settings
thermo 1

# Initial minimization to relax the system before dynamics
minimize 1.0e-4 1.0e-6 100 1000

# Run your simulation
timestep 0.001
fix 1 all nvt temp 300.0 300.0 0.1
dump 1 all custom 10 dump.xyz id type x y z

run 2000




# example 2

log log.lammps
units metal
atom_style atomic
dimension  3
boundary p p p
newton on

read_data initial.data

# Define the IANN pair style
pair_style iann painn export_ensemble_painn.pth  5.5
pair_coeff * *

mass 1 1.0079999997406976 # H
mass 2 195.08399994981576 # Pt

velocity all create 900 126342 dist gaussian rot yes mom yes

timestep 0.0001 # 0.1 fs

#compute variance all iann/variance
#thermo_style custom step pe ke etotal temp press c_variance[1] c_variance[2] c_variance[3] c_variance[4]
#thermo_modify colname c_variance[1] energy_var
#thermo_modify colname c_variance[2] force_var
#thermo_modify colname c_variance[3] max_energy_var
#thermo_modify colname c_variance[4] max_force_var
#thermo_modify flush yes

thermo_style custom step temp vol pe cella cellb cellc cellalpha cellbeta cellgamma pxx pyy pzz press
thermo 100

compute coord all coord/atom cutoff 1.0 2
dump 1 all custom 10000 dump.xyz id type x y z fx fy fz vx vy vz c_coord
# dump 1 all custom 10 dump.xyz id type x y z
dump_modify 1 sort id

info computes
variable v equal vol
variable t equal temp
variable p equal press
variable px equal pxx
variable py equal pyy
variable pz equal pzz

fix ave all ave/time 1 1000 1000 v_v v_t v_p v_px v_py v_pz file output.txt
fix integrator all nvt temp 900 900 0.1

# record rolling average of volume, temperature, and pressure
#fix 1 all ave/time 1 1000 1000 v_v v_t v_p v_px v_py v_pz file output.txt

# equilibrate with box height frozen
#fix 2 all npt temp 900 900 0.1 x 0.0 0.0 1.0 y 0.0 0.0 1.0
run 5000000  # 0.5 ns
#unfix 2

# Cleanup
unfix           integrator
unfix           ave


# Python
__pycache__/
*.pyc

# OS
*.DS_Store

# Build artifacts
build/*
# Only the top-level build/ -- a pattern containing a slash is anchored here, so
# docs/build/html is NOT covered and stays tracked.

# Trained models and checkpoints
*.pth
test/*/*.pt
test/painn/model_*

# Datasets generated by the test scripts. test/*.traj is a tracked fixture
# and must not be ignored, which is why these are one level deep or dft-prefixed.
test/dft*.traj
test/*/*.traj

# Run outputs and logs
*output*
*.log
*log.txt

# Scratch directories
iann/models/test
test/test

# Agent tool configuration, generated by `iann agent install` 
.claude/

# Ignoring it here keeps the two histories from mixing.
proj/*

# Machine-readable run artifacts, e.g. the run.json manifest that `iann train`
# writes beside a checkpoint.
*.json

# --------------------------------------------------------------------------
# Two patterns above are broader than they look, deliberately left as they are
# because narrowing them would start tracking files that are currently ignored:
#
#   *output*  matches the substring anywhere in a path, so a source file named
#             output_writer.py would be ignored too. Name new sources carefully,
#             or add a negation such as !iann/**/output*.py.
#   *.json    ignores every JSON file in the repository. If a JSON file ever
#             needs to be tracked, force it with `git add -f` or add a negation
#             such as !package.json.
# --------------------------------------------------------------------------
